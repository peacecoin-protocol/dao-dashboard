NEXT_PUBLIC_APP_ENV=DEV
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_ENABLE_TESTNETS=true
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key
NEXT_PUBLIC_HOODI_RPC_URL=https://eth-hoodi.g.alchemy.com/v2/your_alchemy_api_key
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_alchemy_api_key
NEXT_PUBLIC_SEPOLIA_WEBSOCKET_URL=wss://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key
NEXT_PUBLIC_LOCALHOST_RPC_URL=http://localhost:8545
NEXT_PUBLIC_PINATA_GATEWAY_URL=https://your-pinata-gateway.mypinata.cloud

NEXT_PUBLIC_PINATA_SBT_GROUP_ID_DEV=your-dev-sbt-group-id
NEXT_PUBLIC_PINATA_SBT_GROUP_ID_STG=your-stg-sbt-group-id
NEXT_PUBLIC_PINATA_SBT_GROUP_ID_PROD=your-prod-sbt-group-id

NEXT_PUBLIC_PINATA_NFT_GROUP_ID_DEV=your-dev-nft-group-id
NEXT_PUBLIC_PINATA_NFT_GROUP_ID_STG=your-stg-nft-group-id
NEXT_PUBLIC_PINATA_NFT_GROUP_ID_PROD=your-prod-nft-group-id

NEXT_PUBLIC_PINATA_DAO_GROUP_ID_DEV=your-dev-dao-group-id
NEXT_PUBLIC_PINATA_DAO_GROUP_ID_STG=your-stg-dao-group-id
NEXT_PUBLIC_PINATA_DAO_GROUP_ID_PROD=your-prod-dao-group-id

NEXT_PUBLIC_PINATA_JSON_GROUP_ID_DEV=your-dev-json-group-id
NEXT_PUBLIC_PINATA_JSON_GROUP_ID_STG=your-stg-json-group-id
NEXT_PUBLIC_PINATA_JSON_GROUP_ID_PROD=your-prod-json-group-id

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secrets
PINATA_JWT=your_pinata_jwt
MORALIS_API_KEY=your_moralis_api_key
GITHUB_ACCESS_TOKEN=your_github_access_token
